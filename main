            ],
            personal: [
                { id: 'c12', text: '個人常備藥品 (感冒/腸胃/暈車)' },
                { id: 'c13', text: '高保濕面霜 / 護唇膏' },
                { id: 'c14', text: '折疊傘 / 隨身保溫瓶' }
            ]
        };

        function renderChecklist() {
            const savedState = JSON.parse(localStorage.getItem('hokkaido_checklist_v1') || '{}');

            Object.keys(checklistData).forEach(group => {
                const container = document.getElementById(`group-${group}`);
                if (!container) return;

                container.innerHTML = checklistData[group].map(item => {
                    const isChecked = savedState[item.id] ? 'checked' : '';
                    return `
                        <label class="checklist-item flex items-center space-x-2 cursor-pointer select-none">
                            <input type="checkbox" id="${item.id}" ${isChecked} onchange="toggleCheck('${item.id}')" 
                                class="w-4 h-4 accent-coral rounded border-2 border-ink cursor-pointer">
                            <span class="text-xs sm:text-sm font-bold text-ink">${item.text}</span>
                        </label>
                    `;
                }).join('');
            });
        }

        function toggleCheck(id) {
            const savedState = JSON.parse(localStorage.getItem('hokkaido_checklist_v1') || '{}');
            const checkbox = document.getElementById(id);
            if (checkbox) {
                savedState[id] = checkbox.checked;
                localStorage.setItem('hokkaido_checklist_v1', JSON.stringify(savedState));
            }
        }

        function resetChecklist() {
            localStorage.removeItem('hokkaido_checklist_v1');
            renderChecklist();
        }

        renderChecklist();
    </script>
</body>
</html>