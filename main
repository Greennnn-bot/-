        // 交通標籤顏色映射
        const tagColors = {
            "集合": "bg-coral text-white",
            "專機": "bg-mizu text-ink",
            "抵達": "bg-wakatake text-ink",
            "專車": "bg-yamabuki text-ink",
            "纜車": "bg-coral text-white",
            "步行": "bg-wakatake text-ink",
            "自由活動": "bg-mizu text-ink",
            "購物": "bg-yamabuki text-ink",
            "住宿": "bg-paper border-2 border-ink text-ink"
        };

        function switchDay(dayNum) {
            // 切換 active tab 樣式
            for (let i = 1; i <= 5; i++) {
                const tab = document.getElementById(`tab-${i}`);
                if (i === dayNum) {
                    tab.className = "py-2.5 px-1 picture-box-sm bg-coral text-white text-center font-black transition-all bounce-anim";
                } else {
                    tab.className = "py-2.5 px-1 picture-box-sm bg-white text-ink text-center font-black transition-all hover:bg-mizu/20";
                }
            }

            // 渲染內容
            const data = itineraryData[dayNum];
            const container = document.getElementById('itinerary-content');

            let eventsHtml = data.events.map((e, idx) => `
                <div class="flex gap-3 sm:gap-4 relative group">
                    <!-- 左側時間與軸線 -->
                    <div class="flex flex-col items-center shrink-0 w-14 sm:w-16">
                        <span class="text-xs sm:text-sm font-black bg-white px-1.5 py-0.5 picture-box-sm">${e.time}</span>
                        ${idx !== data.events.length - 1 ? '<div class="w-1 bg-ink/20 flex-1 my-1"></div>' : ''}
                    </div>

                    <!-- 右側內容卡片 -->
                    <div class="bg-white p-3.5 sm:p-4 picture-box-sm flex-1 mb-3">
                        <div class="flex flex-wrap items-center gap-1.5 mb-1">
                            <span class="text-xs picture-tag ${tagColors[e.type] || 'bg-white'}">${e.type}</span>
                            ${e.isMust ? '<span class="text-xs picture-tag bg-coral text-white">⭐ 必去重點</span>' : ''}
                            <h3 class="text-sm sm:text-base font-black text-ink">${e.title}</h3>
                        </div>
                        <p class="text-xs text-gray-600 leading-relaxed mt-1">${e.desc}</p>
                    </div>
                </div>
            `).join('');

            container.innerHTML = `
                <div class="flex justify-between items-center border-b-2 border-ink/20 pb-4 mb-6">
                    <div>
                        <span class="text-xs text-gray-500 font-bold">${data.date}</span>
                        <h3 class="text-base sm:text-xl font-black text-ink">${data.title}</h3>
                    </div>
                    <div>${data.svg}</div>
                </div>
                <div class="space-y-1">
                    ${eventsHtml}
                </div>
            `;
        }

        // 初始化預設為 Day 1
        switchDay(1);

        // ----------------------------------------------------
        // 3. 可打勾行李/待辦清單 (LocalStorage 保存)
        // ----------------------------------------------------
        const checklistData = {
            docs: [
                { id: 'c1', text: '護照 (效期 6 個月以上)' },
                { id: 'c2', text: '日幣現金 / 海外信用卡' },
