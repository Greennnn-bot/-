                { id: 'c7', text: '防滑雪靴 / 厚毛襪' },
                { id: 'c8', text: '毛帽 / 圍巾 / 防水手套' }
            ],
            tech: [
                { id: 'c9', text: '日本上網 SIM 卡 / 漫遊器' },
